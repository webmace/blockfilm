#!/usr/bin/env bash
# Blockfilm starten:
#   blockfilm                      Programm öffnen
#   blockfilm mein-film.txt        Programm mit diesem Skript öffnen (Datei wird beobachtet)
#   blockfilm --render mein-film.txt [-o video.mp4] [--4k|--1080p|--720p]   Video ohne Fenster bauen
HIER="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# Node finden (auch wenn aus dem App-Menü gestartet, wo mise nicht im PATH ist)
NODE="$(command -v node 2>/dev/null)"
for k in "$HOME/.local/share/mise/installs/node/latest/bin/node" /usr/bin/node /usr/local/bin/node; do
  [ -z "$NODE" ] && [ -x "$k" ] && NODE="$k"
done
if [ -z "$NODE" ]; then notify-send "Blockfilm" "Node.js wurde nicht gefunden." 2>/dev/null; echo "Node.js fehlt" >&2; exit 1; fi
exec "$NODE" "$HIER/server.mjs" "$@"
